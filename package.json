{
  "name": "landing-marketing-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Domain-agnostic Landing Marketing Kit — design tokens, UI primitives, marketing components and conversion patterns for SaaS landing pages.",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency 1 --filter \"./packages/*\" build",
    "dev": "pnpm --filter playground dev",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --workspace-concurrency 1 --filter \"./packages/*\" typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/check-bundle-size.mjs",
    "guidance": "node scripts/generate-content-guidance.mts",
    "check": "pnpm typecheck && pnpm lint && pnpm size && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^26.1.0",
    "lighthouse": "^13.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^4.1.11"
  }
}
